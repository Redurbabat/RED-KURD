{
  "name": "red-kurd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --test",
    "data:check": "node scripts/upload-cloud-data.mjs --dry-run",
    "data:upload": "node scripts/upload-cloud-data.mjs",
    "app:upload": "node scripts/upload-cloud-data.mjs dist --prefix=app --exclude=server,daten,.openai",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test scripts server.js sites",
    "content:check": "node --test test/course-content.test.js test/language-courses.test.js",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.77.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.11"
  }
}
